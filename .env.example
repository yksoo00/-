# Gemini AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# eBay (optional — 미설정 시 공개 검색페이지 스크래핑으로 자동 대체)
# EBAY_APP_ID  = developer.ebay.com/my/keys → App ID (Client ID)
# EBAY_CERT_ID = 같은 페이지 → Cert ID (Client Secret). Dev ID와 다른 값이니 혜동 주의.
# EBAY_ENV는 발급받은 키셋과 반드시 일치해야 함 (Sandbox 키 ↔ production 설정 조합 절대 금지, 인증 실패함)
# EBAY_MARKETPLACE = EBAY_US 고정 (독일/프랑스와 달리 한국 전용 마켓플레이스(EBAY_KR)는 존재하지 않음)
# EBAY_BUYER_COUNTRY = 배송비/배송가능 여부를 추정받을 구매자 국가 코드 (기본값 KR)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US
EBAY_BUYER_COUNTRY=KR

# MySQL
DATABASE_URL=mysql+pymysql://inventory_app:CHANGE_ME@localhost:3306/inventory
SECRET_KEY=CHANGE_ME
MYSQL_DATABASE=inventory
MYSQL_USER=inventory_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

UPLOAD_MAX_MB=100
SEARCH_DEBOUNCE_MS=300

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_CONSOLE=1
